root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,json,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,bat,cmd}]
end_of_line = crlf

# BOM, Windows PowerShell 5.1'in Türkçe metni doğru okuması için gereklidir.
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
