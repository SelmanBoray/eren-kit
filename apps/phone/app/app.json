{
  "expo": {
    "name": "eren-kit",
    "slug": "eren-kit",
    "version": "0.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "dev.eren.app",
      "versionCode": 10,
      "backgroundColor": "#101A1E",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-gradle-memory.js",
      "./plugins/with-min-sdk.js",
      "./plugins/with-splash-zemin.js",
      "./plugins/with-release-imza.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Eren, sohbete eklemen için fotoğraf ve videolarını seçmene izin ister.",
          "cameraPermission": "Eren, sohbete eklemen için fotoğraf ve video çekmene izin ister.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
