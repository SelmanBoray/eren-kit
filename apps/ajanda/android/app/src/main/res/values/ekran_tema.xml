<?xml version="1.0" encoding="utf-8"?>
<!--
  K4: ekranların teması. Manifestteki uygulama teması (Light) dondurulmuş olduğundan etkinlikler bunu
  onCreate'te super'den önce setTheme ile alır; koyu karşılığı values-night/ekran_tema.xml.
-->
<resources>
    <style name="EkranTema" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/ekran_vurgu</item>
        <item name="android:colorPrimary">@color/ekran_vurgu</item>
        <item name="android:colorPrimaryDark">@color/ekran_zemin</item>
        <item name="android:colorBackground">@color/ekran_zemin</item>
        <item name="android:windowBackground">@color/ekran_zemin</item>
        <item name="android:statusBarColor">@color/ekran_zemin</item>
        <item name="android:navigationBarColor">@color/ekran_zemin</item>
        <item name="android:textColorPrimary">@color/ekran_murekkep</item>
        <item name="android:textColorSecondary">@color/ekran_soluk</item>
        <item name="android:textColorHint">@color/ekran_soluk</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
